{
  "name": "openreboot",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Open-source, local-first personal change training system. Designed to become unnecessary.",
  "keywords": [
    "behavior-change",
    "local-first",
    "offline-first",
    "pwa",
    "self-hosted",
    "open-source"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:json": "vitest run --reporter=json --outputFile=.gate/vitest.json",
    "gate": "node scripts/gate.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
